# ══════════════════════════════════════════════════════
#  VARIABLES DE ENTORNO — PRODUCCIÓN (DonWeb VPS)
#  Copiar este archivo como .env en el servidor:
#    cp .env.production.example .env
#  ¡NUNCA commitear el .env real a Git!
# ══════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# ── PostgreSQL ─────────────────────────────────────────
# En producción PostgreSQL corre localmente en el VPS (sin Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=padel_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA_DE_PRODUCCION
DB_DATABASE=padelsys_prod

# ── JWT ────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERAR_SECRET_64_CHARS_MINIMO_EN_PRODUCCION
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=GENERAR_OTRO_SECRET_DIFERENTE_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────
# Reemplazar con el dominio real del VPS
CORS_ORIGIN=https://tudominio.com
