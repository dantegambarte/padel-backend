# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=padel_user
DB_PASSWORD=padel_secret
DB_DATABASE=padelsys
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_seguro
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=otro_secreto_diferente_para_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:4200

# Bind address (production: 127.0.0.1 behind Nginx)
HOST=0.0.0.0

# ── Logging / error reporting ─────────────────────────
# json | pretty (default: json when NODE_ENV=production, pretty otherwise)
LOG_FORMAT=
# Optional webhook that receives a JSON alert for every unhandled 5xx error. Empty = disabled.
ERROR_WEBHOOK_URL=
# Optional Sentry monitoring. Empty DSN = disabled. Events are redacted and carry no user data.
SENTRY_DSN=
# Defaults to NODE_ENV
SENTRY_ENVIRONMENT=
# e.g. the deployed git SHA
SENTRY_RELEASE=

# ── Privacy ───────────────────────────────────────────
# Days an inactive fixed booking or teacher keeps its phone number (default 365)
CUSTOMER_PHONE_RETENTION_DAYS=365
